# ERP Global Pro local / server configuration example
ERP_ENV=development
# Required when ERP_ENV=production. Generate a long random secret.
# ERP_SECRET_KEY=replace-with-a-long-random-secret
ERP_DB_PATH=backend/instance/erp.sqlite3
ERP_FILE_STORAGE_DIR=backend/instance/files
ERP_TOKEN_TTL_HOURS=12
ERP_CORS_ORIGINS=

# Private file storage hardening (Stage 16)
ERP_FILE_QUOTA_BYTES=262144000
ERP_FILE_UPLOADS_PER_HOUR=30
ERP_CLAMSCAN_BIN=clamscan
# Set to 1 only while the web server is stopped for restore operations.
ERP_MAINTENANCE_MODE=0
